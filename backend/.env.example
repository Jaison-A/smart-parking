PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart_parking
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Must match the detector's DETECTOR_API_KEY
DETECTOR_API_KEY=change-me-detector-key
DETECTOR_URL=http://localhost:8001

# Where React runs, for CORS + Socket.IO
FRONTEND_URL=http://localhost:5173

# Leave unset for local dev. Set this ONLY when deploying backend and
# detection-service to separate hosts with no shared disk (e.g. backend on
# Render, detector on Hugging Face Spaces) - this backend's own public URL,
# so uploaded videos can be handed to the detector as a link instead of a
# local file path. Example: https://smart-parking-backend.onrender.com
PUBLIC_BASE_URL=

# Starting fine amounts (currency units). Admins can change these any time from
# the Settings page; once saved there, the saved values are used instead.
FINE_BASE_AMOUNT=500
FINE_PER_EXTRA_MINUTE=20
# Flat fine for spacing / bay violations
FINE_RULE_AMOUNT=200

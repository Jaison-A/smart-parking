# Copy to .env and adjust.
# How hard to look for vehicles: fast | balanced | max
#   fast     smallest model, quickest, misses small/distant vehicles
#   balanced default
#   max      biggest model + 1280px + low confidence + forgiving tracker: finds the
#            most vehicles, but several times slower (realistic only on a GPU)
DETECTION_MODE=balanced
# Optional - leave these commented out so the mode above decides. Setting them
# here OVERRIDES the mode (an old YOLO_IMGSZ=960 line would silently beat "max").
# YOLO_MODEL=yolo11s.pt
# YOLO_IMGSZ=640
# YOLO_CONF=0.3

# Parking rules (see README): spacing between parked vehicles, and bay checks.
# Gap as a fraction of the narrower vehicle's width. 0 turns the spacing rule off.
MIN_GAP_RATIO=0.25
# Share of the vehicle's footprint that must sit inside its bay.
BAY_MIN_OVERLAP=0.5
# Seconds a spacing/bay problem must persist before it counts as a violation.
RULE_HOLD_S=5

# Number plate reading
PLATE_OCR=1
# Optional: path to a YOLO model trained to detect licence plates (improves accuracy a lot)
PLATE_MODEL=
# Plates are validated against this pattern (default: Indian format, e.g. TN75AB1234)
PLATE_REGEX=^[A-Z]{2}\d{1,2}[A-Z]{0,3}\d{4}$
# Vehicles narrower than this (pixels) are too small to read a plate from - skipped
# to save CPU. Lower it for a close-up gate camera, 0 to always try.
PLATE_MIN_VEHICLE_PX=140

# Where uploaded videos live (must match the backend's uploads/videos folder)
VIDEO_ROOT=../backend/uploads/videos

# Talking to the Node backend
BACKEND_URL=http://localhost:5000
DETECTOR_API_KEY=change-me-detector-key
